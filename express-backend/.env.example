PORT=8001

# AWS RDS PostgreSQL Database
DATABASE_URL=postgresql://postgres:PASSWORD@monthlygrocery-db.chw8ms662utr.ap-south-1.rds.amazonaws.com:5432/postgres

# Security Settings
JWT_SECRET=your_jwt_secret_here
DEV_OTP_BYPASS=false

# 2Factor SMS & OTP Configuration
TWO_FACTOR_API_KEY=your_2factor_api_key_here
TWO_FACTOR_OTP_TEMPLATE=OTP1

# Default Super Admin
SUPER_ADMIN_MOBILE=+918830480015
SUPER_ADMIN_NAME=Admin Name

# Business Constraints
MIN_ORDER_LIMIT=1000

# Google Maps API Key (Optional)
GOOGLE_MAPS_API_KEY=

# AWS S3 Media Storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
 
# Over-The-Air (OTA) Updates
OTA_DEPLOY_KEY=monthly-grocery-ota-secret-key
